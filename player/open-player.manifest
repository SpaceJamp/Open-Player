<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows: run with UTF-8 as the process code page, so argv, fopen, std::filesystem and FFmpeg all take UTF-8
     paths like the Linux build does (file names such as "Vidéos" or "Amélie" open). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
